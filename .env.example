# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Crea una OAuth App a: https://github.com/settings/developers
# Homepage URL:      http://localhost:8000
# Callback URL:      http://localhost:8000/auth/callback
GITHUB_CLIENT_ID=el_teu_github_client_id
GITHUB_CLIENT_SECRET=el_teu_github_client_secret

# ── API Token (per a Postman / tests sense sessió web) ────────────────────────
# Genera un token segur, p.ex.:  php -r "echo bin2hex(random_bytes(32));"
API_TOKEN=canvia_aquest_token_per_un_de_segur
